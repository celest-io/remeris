amends "Config.pkl"

import "Builtins.pkl" as BaseBuiltins

/// Linters that do not depend on the language of the repository. `hk.pkl` amends this file and adds the steps of
/// the stack (Go) and of the GitHub Actions setup. Re-declaring `steps { }` merges new keys in rather than
/// replacing the base.
///
/// Import Builtins.pkl under an alias other than `Builtins` here (not the default name): a consumer's own separate
/// `import ".../Builtins.pkl"` bound to the same name as a base module's import resolves to an untyped `Dynamic`.
///
/// Agent instruction and config markdown: tool-owned, not ours to lint.
local agentMarkdown =
  List(
    "**/CLAUDE.md",
    "**/CLAUDE.local.md",
    "**/AGENTS.md",
    "**/GEMINI.md",
    "**/.claude/**",
    "**/.agents/**",
    "**/.cursor/**",
    "**/.windsurf/**",
    "**/.clinerules/**",
    "**/.gemini/**",
    "**/.codex/**",
    ".github/copilot-instructions.md",
    ".github/instructions/**",
    ".github/prompts/**",
    ".github/agents/**",
  )

steps {
  // repo guards
  ["trailing-whitespace"] = BaseBuiltins.trailing_whitespace
  ["end-of-file-fixer"] = BaseBuiltins.newlines
  ["mixed-line-ending"] = BaseBuiltins.mixed_line_ending
  ["check-symlinks"] = BaseBuiltins.check_symlinks
  ["check-added-large-files"] = BaseBuiltins.check_added_large_files
  ["check-executables-have-shebangs"] = BaseBuiltins.check_executables_have_shebangs
  ["check-merge-conflict"] = BaseBuiltins.check_merge_conflict
  ["detect-private-key"] = BaseBuiltins.detect_private_key

  // config languages
  ["mise"] = BaseBuiltins.mise

  // yaml
  ["ryl"] = BaseBuiltins.ryl
  ["ryl_format"] = BaseBuiltins.ryl_format

  // markdown
  ["ryl_markdown"] = (BaseBuiltins.ryl_markdown) { exclude = agentMarkdown }
  ["ryl_markdown_format"] = (BaseBuiltins.ryl_markdown_format) { exclude = agentMarkdown }
  ["rumdl"] = (BaseBuiltins.rumdl) { exclude = agentMarkdown }
}

hooks {
  // If mise-pinned versions change, auto-install them on pull (merge and rebase).
  ["post-merge"] {
    steps {
      ["mise-install"] { glob = "mise.toml"; check = "mise install" }
    }
  }
  ["post-rewrite"] {
    steps {
      ["mise-install"] { glob = "mise.toml"; check = "mise install" }
    }
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      // If mise.toml or its lockfile changed, regenerate mise.lock for linux-x64, linux-arm64 and macos-arm64.
      ["mise-lock"] {
        glob = List("mise.toml", "mise.lock")
        fix = "mise lock --platform linux-x64,linux-arm64,macos-arm64"
        stage = "mise.lock"
      }
    }
  }
}

warnings = List("missing-profiles")
