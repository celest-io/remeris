{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Go toolchain: go.mod and mise.toml move together",
      "matchPackageNames": [
        "go",
        "golang/go"
      ],
      "groupName": "go toolchain"
    },
    {
      "description": "hk: the version in mise.toml and the Pkl package URLs in hk/Config.pkl and hk/Builtins.pkl move together",
      "matchPackageNames": [
        "hk",
        "jdx/hk"
      ],
      "groupName": "hk"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "hk Pkl package URLs in hk/Config.pkl and hk/Builtins.pkl",
      "managerFilePatterns": [
        "/(^|/)hk/(Config|Builtins)\\.pkl$/"
      ],
      "matchStrings": [
        "github\\.com/jdx/hk/releases/download/v(?<currentValue>[^/]+)/hk@"
      ],
      "depNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
