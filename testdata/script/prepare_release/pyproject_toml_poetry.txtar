# Ported from knope-dev/knope, crates/knope/tests/prepare_release/pyproject_toml/poetry (MIT, see testdata/README.md).

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'feat: Existing feature' --author 'Knope <knope@example.com>'
exec git tag v1.0.0
exec git commit --allow-empty -m 'feat!: New feature' --author 'Knope <knope@example.com>'

exec remeris --dry-run release
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris release
! stdout .
! stderr .
cmp pyproject.toml out/pyproject.toml

-- knope.toml --
[package]
versioned_files = ["pyproject.toml"]

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"
-- pyproject.toml --
[project]
version = "1.0.0"
-- dryrun_stdout.log --
Would add the following to pyproject.toml: 2.0.0
Would add files to git:
  pyproject.toml
-- out/pyproject.toml --
[project]
version = "2.0.0"
