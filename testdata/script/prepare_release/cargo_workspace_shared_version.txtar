# Ported from knope-dev/knope, crates/knope/tests/prepare_release/cargo/workspace/shared_version (MIT, see testdata/README.md).
skip 'needs Cargo.lock support (milestone M9)'

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'Initial commit' --author 'Knope <knope@example.com>'
exec git commit --allow-empty -m 'feat: A feature' --author 'Knope <knope@example.com>'

cp first/Cargo.toml first/Cargo.toml.orig
cp second/Cargo.toml second/Cargo.toml.orig

exec remeris --dry-run release
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris release
! stdout .
! stderr .
cmp Cargo.toml out/Cargo.toml
cmp Cargo.lock out/Cargo.lock
cmp first/Cargo.toml first/Cargo.toml.orig
cmp second/Cargo.toml second/Cargo.toml.orig

-- Cargo.lock --
# This file is automatically @generated by Cargo.
# It is not intended for manual editing.
version = 3

[[package]]
name = "first-package"
version = "1.2.3"
dependencies = [
    "something",
]

[[package]]
name = "second-package"
version = "1.2.3"
dependencies = [
    "something-else",
]
-- Cargo.toml --
[workspace]
members = ["first", "second"]

[workspace.package]
version = "1.2.3"

[package]
name = "root"
version.workspace = true
-- first/Cargo.toml --
[package]
name = "first-package"
version.workspace = true

[dependencies]
second-package = { path = "../second" }
-- knope.toml --
[package]
versioned_files = [
  "Cargo.toml",
  { path = "Cargo.lock", dependency = "first-package" },
  { path = "Cargo.lock", dependency = "second-package" },
]

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"
-- second/Cargo.toml --
[package]
name = "second-package"
version.workspace = true
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 1.3.0
Would add the following to Cargo.lock: first-package = 1.3.0, second-package = 1.3.0
Would add files to git:
  Cargo.toml
  Cargo.lock
-- out/Cargo.lock --
# This file is automatically @generated by Cargo.
# It is not intended for manual editing.
version = 3

[[package]]
name = "first-package"
version = "1.3.0"
dependencies = [
    "something",
]

[[package]]
name = "second-package"
version = "1.3.0"
dependencies = [
    "something-else",
]
-- out/Cargo.toml --
[workspace]
members = ["first", "second"]

[workspace.package]
version = "1.3.0"

[package]
name = "root"
version.workspace = true
