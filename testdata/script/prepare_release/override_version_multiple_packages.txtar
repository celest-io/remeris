# Ported from knope-dev/knope, crates/knope/tests/prepare_release/override_version_multiple_packages (MIT, see testdata/README.md).

env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'feat: Existing feature' --author 'Knope <knope@example.com>'
exec git tag first/v0.1.0
exec git tag second/v1.2.3
exec git tag third/v4.5.5
exec git commit --allow-empty -m 'fix: A bug fix' --author 'Knope <knope@example.com>'

exec remeris --dry-run release --override-version=first=1.0.0 --override-version=second=4.5.6
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris release --override-version=first=1.0.0 --override-version=second=4.5.6
! stdout .
! stderr .
cmp Cargo.toml out/Cargo.toml
cmp FIRST_CHANGELOG.md out/FIRST_CHANGELOG.md
cmp THIRD_CHANGELOG.md out/THIRD_CHANGELOG.md
exec sh -c 'printf %s "$(cat out/package.json)" > package.json.want'
cmp package.json package.json.want
cmp SECOND_CHANGELOG.md out/SECOND_CHANGELOG.md
cmp pyproject.toml out/pyproject.toml

-- Cargo.toml --
[package]
name = "default"
version = "0.1.0"
-- FIRST_CHANGELOG.md --
## 0.1.0

Some existing content
-- SECOND_CHANGELOG.md --
## 1.2.3

Some existing content
-- THIRD_CHANGELOG.md --
## 4.5.5

Some existing content
-- knope.toml --
[packages.first]
versioned_files = ["Cargo.toml"]
changelog = "FIRST_CHANGELOG.md"

[packages.second]
versioned_files = ["package.json"]
changelog = "SECOND_CHANGELOG.md"

[packages.third]
versioned_files = ["pyproject.toml"]
changelog = "THIRD_CHANGELOG.md"

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"
-- package.json --
{
  "version": "1.2.3"
}
-- pyproject.toml --
[tool.poetry]
version = "4.5.5"
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 1.0.0
Would add the following to package.json: version = 4.5.6
Would add the following to pyproject.toml: 4.5.6
Would add the following to FIRST_CHANGELOG.md:
## 1.0.0 (2026-01-01)

### Fixes

- A bug fix

Would add the following to SECOND_CHANGELOG.md:
## 4.5.6 (2026-01-01)

### Fixes

- A bug fix

Would add the following to THIRD_CHANGELOG.md:
## 4.5.6 (2026-01-01)

### Fixes

- A bug fix

Would add files to git:
  Cargo.toml
  package.json
  pyproject.toml
  FIRST_CHANGELOG.md
  SECOND_CHANGELOG.md
  THIRD_CHANGELOG.md
-- out/Cargo.toml --
[package]
name = "default"
version = "1.0.0"
-- out/FIRST_CHANGELOG.md --
## 1.0.0 (2026-01-01)

### Fixes

- A bug fix

## 0.1.0

Some existing content
-- out/SECOND_CHANGELOG.md --
## 4.5.6 (2026-01-01)

### Fixes

- A bug fix

## 1.2.3

Some existing content
-- out/THIRD_CHANGELOG.md --
## 4.5.6 (2026-01-01)

### Fixes

- A bug fix

## 4.5.5

Some existing content
-- out/package.json --
{
  "version": "4.5.6"
}
-- out/pyproject.toml --
[tool.poetry]
version = "4.5.6"
