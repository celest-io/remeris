# Ported from knope-dev/knope, crates/knope/tests/prepare_release/go_modules/version_determination (MIT, see testdata/README.md).

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'Initial commit' --author 'Knope <knope@example.com>'
exec git tag v1.2.3
exec git tag with_comment/v0.1.0
exec git tag without_comment/v1.2.3
exec git commit --allow-empty -m 'feat: A feature' --author 'Knope <knope@example.com>'

exec remeris --dry-run prepare-release
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris prepare-release
! stdout .
! stderr .
cmp go.mod out/go.mod
cmp Cargo.toml out/Cargo.toml
cmp with_comment/go.mod out/with_comment/go.mod
cmp without_comment/go.mod out/without_comment/go.mod

-- Cargo.toml --
[package]
name = "default"
version = "1.2.3"
-- go.mod --
module toplevel
-- knope.toml --
[package]
versioned_files = [
  "Cargo.toml",
  "go.mod",
  "with_comment/go.mod",
  "without_comment/go.mod",
]

[[workflows]]
name = "prepare-release"

[[workflows.steps]]
type = "PrepareRelease"
-- with_comment/go.mod --
module withcomment // v1.2.3
-- without_comment/go.mod --
module withoutcomment
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 1.3.0
Would add the following to go.mod: 1.3.0
Would add the following to with_comment/go.mod: 1.3.0
Would add the following to without_comment/go.mod: 1.3.0
Would add files to git:
  Cargo.toml
  go.mod
  with_comment/go.mod
  without_comment/go.mod
-- out/Cargo.toml --
[package]
name = "default"
version = "1.3.0"
-- out/go.mod --
module toplevel // v1.3.0
-- out/with_comment/go.mod --
module withcomment // v1.3.0
-- out/without_comment/go.mod --
module withoutcomment // v1.3.0
