# Ported from knope-dev/knope, crates/knope/tests/prepare_release/enable_prerelease (MIT, see testdata/README.md).

env REMERIS_FAKE_DATE=2026-01-01
env KNOPE_PRERELEASE_LABEL=rc

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'Initial commit' --author 'Knope <knope@example.com>'
exec git tag v1.0.0
exec git commit --allow-empty -m 'feat: New feature in existing release' --author 'Knope <knope@example.com>'
exec git tag v1.1.0
exec git commit --allow-empty -m 'feat!: Breaking feature in new RC' --author 'Knope <knope@example.com>'

exec remeris --dry-run prerelease
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris prerelease
! stdout .
! stderr .
cmp CHANGELOG.md out/CHANGELOG.md
cmp Cargo.toml out/Cargo.toml

-- CHANGELOG.md --
## 1.1.0

### Features

- New feature in existing release
-- Cargo.toml --
[package]
name = "default"
version = "1.1.0"
-- knope.toml --
[package]
versioned_files = ["Cargo.toml"]
changelog = "CHANGELOG.md"

[[workflows]]
name = "prerelease"

[[workflows.steps]]
type = "PrepareRelease"
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 2.0.0-rc.0
Would add the following to CHANGELOG.md:
## 2.0.0-rc.0 (2026-01-01)

### Breaking Changes

- Breaking feature in new RC

Would add files to git:
  Cargo.toml
  CHANGELOG.md
-- out/CHANGELOG.md --
## 2.0.0-rc.0 (2026-01-01)

### Breaking Changes

- Breaking feature in new RC

## 1.1.0

### Features

- New feature in existing release
-- out/Cargo.toml --
[package]
name = "default"
version = "2.0.0-rc.0"
