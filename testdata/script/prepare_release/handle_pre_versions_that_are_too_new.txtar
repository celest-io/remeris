# Ported from knope-dev/knope, crates/knope/tests/prepare_release/handle_pre_versions_that_are_too_new (MIT, see testdata/README.md).

env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'Initial commit' --author 'Knope <knope@example.com>'
exec git tag v2.0.0-rc.0
exec git tag v1.2.3
exec git commit --allow-empty -m 'feat: A new feature' --author 'Knope <knope@example.com>'
exec git tag v1.3.0-rc.0
exec git commit --allow-empty -m 'feat: Another new feature' --author 'Knope <knope@example.com>'

exec remeris --dry-run prerelease
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris prerelease
! stdout .
! stderr .
cmp Cargo.toml out/Cargo.toml

-- Cargo.toml --
[package]
name = "default"
version = "1.2.3"
-- knope.toml --
[package]
versioned_files = ["Cargo.toml"]
changelog = "CHANGELOG.md"

[[workflows]]
name = "prerelease"

[[workflows.steps]]
type = "PrepareRelease"
prerelease_label = "rc"
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 1.3.0-rc.1
Would add the following to CHANGELOG.md:
## 1.3.0-rc.1 (2026-01-01)

### Features

- A new feature
- Another new feature

Would add files to git:
  Cargo.toml
  CHANGELOG.md
-- out/Cargo.toml --
[package]
name = "default"
version = "1.3.0-rc.1"
