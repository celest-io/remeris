# Ported from knope-dev/knope, crates/knope/tests/prepare_release/changesets/happy (MIT, see testdata/README.md).

env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'feat!: Existing feature' --author 'Knope <knope@example.com>'
exec git tag first/v1.2.3
exec git tag second/v0.4.6
exec git commit --allow-empty -m 'feat: A new shared feature from a conventional commit' --author 'Knope <knope@example.com>'

exec remeris --dry-run release
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris release
! stdout .
! stderr .
cmp Cargo.toml out/Cargo.toml
cmp FIRST_CHANGELOG.md out/FIRST_CHANGELOG.md
cmp SECOND_CHANGELOG.md out/SECOND_CHANGELOG.md
grep '"version": "0\.4\.7"' package.json
cmp pyproject.toml out/pyproject.toml
! exists ".changeset/A Complex Feature.md"
! exists ".changeset/breaking-change.md"
! exists ".changeset/simple_feature.md"

-- .changeset/A Complex Feature.md --
---
first: minor
---

#### A complex feature with description

```rust
println!("This format is nicer to read");
```
-- .changeset/breaking-change.md --
---
first: major
---

#### A breaking change

A breaking change for only the first package
-- .changeset/simple_feature.md --
---
first: minor
---

#### A simple feature with no description
-- Cargo.toml --
[package]
name = "default"
version = "1.2.3"
-- FIRST_CHANGELOG.md --
## 1.2.3

Some existing content
-- SECOND_CHANGELOG.md --
## 0.4.6

Some existing content
-- knope.toml --
[packages.first]
versioned_files = ["Cargo.toml", "pyproject.toml"]
changelog = "FIRST_CHANGELOG.md"

[packages.second]
versioned_files = ["package.json"]
changelog = "SECOND_CHANGELOG.md"

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"
-- package.json --
{
  "version": "0.4.6"
}
-- pyproject.toml --
[tool.poetry]
version = "1.2.3"
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 2.0.0
Would add the following to pyproject.toml: 2.0.0
Would add the following to package.json: version = 0.4.7
Would delete .changeset/A Complex Feature.md
Would delete .changeset/breaking-change.md
Would delete .changeset/simple_feature.md
Would add the following to FIRST_CHANGELOG.md:
## 2.0.0 (2026-01-01)

### Breaking Changes

#### A breaking change

A breaking change for only the first package

### Features

- A new shared feature from a conventional commit
- A simple feature with no description

#### A complex feature with description

```rust
println!("This format is nicer to read");
```

Would add the following to SECOND_CHANGELOG.md:
## 0.4.7 (2026-01-01)

### Features

- A new shared feature from a conventional commit

Would add files to git:
  Cargo.toml
  pyproject.toml
  package.json
  .changeset/A Complex Feature.md
  .changeset/breaking-change.md
  .changeset/simple_feature.md
  FIRST_CHANGELOG.md
  SECOND_CHANGELOG.md
-- out/Cargo.toml --
[package]
name = "default"
version = "2.0.0"
-- out/FIRST_CHANGELOG.md --
## 2.0.0 (2026-01-01)

### Breaking Changes

#### A breaking change

A breaking change for only the first package

### Features

- A new shared feature from a conventional commit
- A simple feature with no description

#### A complex feature with description

```rust
println!("This format is nicer to read");
```

## 1.2.3

Some existing content
-- out/SECOND_CHANGELOG.md --
## 0.4.7 (2026-01-01)

### Features

- A new shared feature from a conventional commit

## 0.4.6

Some existing content
-- out/package.json --
{
  "version": "0.4.7"
}
-- out/pyproject.toml --
[tool.poetry]
version = "2.0.0"
