# Ported from knope-dev/knope, crates/knope/tests/prepare_release/multiple_packages (MIT, see testdata/README.md).
skip 'needs Cargo.lock support (milestone M9)'

env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'feat: Existing feature' --author 'Knope <knope@example.com>'
exec git tag first/v1.2.3
exec git tag second/v0.4.6
exec git commit --allow-empty -m 'feat!: New breaking feature' --author 'Knope <knope@example.com>'

exec remeris --dry-run release
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris release
! stdout .
! stderr .
cmp Cargo.lock out/Cargo.lock
cmp Cargo.toml out/Cargo.toml
cmp FIRST_CHANGELOG.md out/FIRST_CHANGELOG.md
cmp SECOND_CHANGELOG.md out/SECOND_CHANGELOG.md
grep '"version": "0\.5\.0"' package.json
cmp pyproject.toml out/pyproject.toml

-- Cargo.lock --
version = 3

[[package]]
name = "multiple-packages"
version = "1.2.3"
-- Cargo.toml --
[package]
name = "multiple-packages"
version = "1.2.3"

[dependencies]
second-package = "0.4.6"

[dev-dependencies]
second-package = { version = "0.4.6" }
-- FIRST_CHANGELOG.md --
## 1.2.3

Some existing content
-- SECOND_CHANGELOG.md --
## 0.4.6

Some existing content
-- knope.toml --
[packages.first]
versioned_files = ["Cargo.toml", "pyproject.toml", "Cargo.lock"]
changelog = "FIRST_CHANGELOG.md"

[packages.second]
versioned_files = [
  "package.json",
  { path = "Cargo.toml", dependency = "second-package" },
]
changelog = "SECOND_CHANGELOG.md"

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"
-- package.json --
{
  "version": "0.4.6"
}
-- pyproject.toml --
[tool.poetry]
version = "1.2.3"
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 2.0.0, second-package.version = 0.5.0
Would add the following to pyproject.toml: 2.0.0
Would add the following to Cargo.lock: multiple-packages = 2.0.0
Would add the following to package.json: version = 0.5.0
Would add the following to FIRST_CHANGELOG.md:
## 2.0.0 (2026-01-01)

### Breaking Changes

- New breaking feature

Would add the following to SECOND_CHANGELOG.md:
## 0.5.0 (2026-01-01)

### Breaking Changes

- New breaking feature

Would add files to git:
  Cargo.toml
  pyproject.toml
  Cargo.lock
  package.json
  FIRST_CHANGELOG.md
  SECOND_CHANGELOG.md
-- out/Cargo.lock --
version = 3

[[package]]
name = "multiple-packages"
version = "2.0.0"
-- out/Cargo.toml --
[package]
name = "multiple-packages"
version = "2.0.0"

[dependencies]
second-package = "0.5.0"

[dev-dependencies]
second-package = { version = "0.5.0" }
-- out/FIRST_CHANGELOG.md --
## 2.0.0 (2026-01-01)

### Breaking Changes

- New breaking feature

## 1.2.3

Some existing content
-- out/SECOND_CHANGELOG.md --
## 0.5.0 (2026-01-01)

### Breaking Changes

- New breaking feature

## 0.4.6

Some existing content
-- out/package.json --
{
  "version": "0.5.0"
}
-- out/pyproject.toml --
[tool.poetry]
version = "2.0.0"
