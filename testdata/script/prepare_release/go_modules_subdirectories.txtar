# Ported from knope-dev/knope, crates/knope/tests/prepare_release/go_modules/subdirectories (MIT, see testdata/README.md).
skip 'needs the Release step (milestone M6)'

env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'feat: Existing feature' --author 'Knope <knope@example.com>'
exec git tag sub_dir/v1.0.0
exec git tag v1.0.0
exec git commit --allow-empty -m 'feat: New feature' --author 'Knope <knope@example.com>'

exec remeris --dry-run release
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris release
! stdout .
! stderr .
cmp CHANGELOG.md out/CHANGELOG.md
cmp sub_dir/go.mod out/sub_dir/go.mod

-- CHANGELOG.md --
## 1.0.0

### Features

- Existing feature
-- knope.toml --
[package]
versioned_files = ["sub_dir/go.mod"]
changelog = "CHANGELOG.md"

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"

[[workflows.steps]]
type = "Release"
-- sub_dir/go.mod --
module github.com/knope-dev/knope

go 1.19

require (
example.com/othermodule v1.2.3
example.com/thismodule v1.2.3
example.com/thatmodule v1.2.3
)

replace example.com/thatmodule => ../thatmodule
exclude example.com/thismodule v1.3.0
-- dryrun_stdout.log --
Would add the following to sub_dir/go.mod: 1.1.0
Would add the following to CHANGELOG.md:
## 1.1.0 (2026-01-01)

### Features

- New feature

Would add files to git:
  sub_dir/go.mod
  CHANGELOG.md
Would create Git tag sub_dir/v1.1.0
Would create Git tag v1.1.0
-- out/CHANGELOG.md --
## 1.1.0 (2026-01-01)

### Features

- New feature

## 1.0.0

### Features

- Existing feature
-- out/sub_dir/go.mod --
module github.com/knope-dev/knope // v1.1.0

go 1.19

require (
example.com/othermodule v1.2.3
example.com/thismodule v1.2.3
example.com/thatmodule v1.2.3
)

replace example.com/thatmodule => ../thatmodule
exclude example.com/thismodule v1.3.0
