# Ported from knope-dev/knope, crates/knope/tests/prepare_release/verbose (MIT, see testdata/README.md).
# Missing from remeris' debug log: "{file} has version {v}", "Looking for Git tags matching package name.",
# "Only checking commits with scopes: [...]", "Using {RULE} rule to bump from {a} to {b}" and
# "Rule is MAJOR, but major component is 0. Bumping minor component from {a} to {b}".
# The "Running step" line is already remeris' own form (spec F3.2).
skip 'remeris bug: --verbose lacks five of Knope''s debug lines (see the note above)'

env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'Initial commit' --author 'Knope <knope@example.com>'
exec git tag first/v1.2.3
exec git tag second/v0.4.6
exec git commit --allow-empty -m 'feat: A feature' --author 'Knope <knope@example.com>'
exec git commit --allow-empty -m 'feat!: A breaking feature' --author 'Knope <knope@example.com>'
exec git commit --allow-empty -m 'fix: A bug fix' --author 'Knope <knope@example.com>'
exec git commit --allow-empty -m 'fix!: A breaking bug fix' --author 'Knope <knope@example.com>'
exec git commit --allow-empty -m 'chore: A chore with a breaking footer' -m 'BREAKING CHANGE: A breaking change' --author 'Knope <knope@example.com>'
exec git commit --allow-empty -m 'feat(first): A feature for the first package' --author 'Knope <knope@example.com>'
exec git commit --allow-empty -m 'feat: A feature with a separate breaking change' -m 'BREAKING CHANGE: Another breaking change' --author 'Knope <knope@example.com>'

exec remeris --dry-run release --verbose
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris release --verbose
cmp stdout stdout.log
! stderr .
! exists .changeset/breaking_change.md
! exists .changeset/feature.md

-- .changeset/breaking_change.md --
---
first: major
---

#### A breaking changeset

A breaking change for only the first package
-- .changeset/feature.md --
---
first: minor
second: patch
---

#### A feature for first, fix for second

And even some details which aren't visible
-- Cargo.toml --
[package]
name = "default"
version = "1.2.3"
-- FIRST_CHANGELOG.md --
## 1.2.3

Some existing content
-- SECOND_CHANGELOG.md --
## 0.4.6

Some existing content
-- knope.toml --
[packages.first]
versioned_files = ["Cargo.toml", "pyproject.toml"]
changelog = "FIRST_CHANGELOG.md"
scopes = ["first"]

[packages.second]
versioned_files = ["package.json"]
changelog = "SECOND_CHANGELOG.md"
scopes = ["second"]

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"
-- package.json --
{
  "version": "0.4.6"
}
-- pyproject.toml --
[tool.poetry]
version = "1.2.3"
-- dryrun_stdout.log --
