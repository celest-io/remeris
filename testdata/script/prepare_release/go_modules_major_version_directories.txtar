# Ported from knope-dev/knope, crates/knope/tests/prepare_release/go_modules/major_version_directories (MIT, see testdata/README.md).
skip 'FAILS: --verbose prints remeris debug lines that differ from Knope (see prepare_release/verbose and testdata/deviations.md)'

env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'Initial commit' --author 'Knope <knope@example.com>'
exec git tag v1.0.0
exec git tag v2.0.0
exec git tag sub_dir/v1.0.0
exec git tag sub_dir/v2.0.0
exec git commit --allow-empty -m 'fix(v1): A fix' --author 'Knope <knope@example.com>'
exec git commit --allow-empty -m 'feat(v2): New feature' --author 'Knope <knope@example.com>'

exec remeris --dry-run release --verbose
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris release --verbose
cmp stdout stdout.log
! stderr .
cmp go.mod out/go.mod
cmp CHANGELOG.md out/CHANGELOG.md
cmp sub_dir/go.mod out/sub_dir/go.mod
cmp sub_dir/v2/go.mod out/sub_dir/v2/go.mod
cmp v2/go.mod out/v2/go.mod
cmp v2/CHANGELOG.md out/v2/CHANGELOG.md

-- CHANGELOG.md --
# CHANGELOG

## 1.0.0

- Initial commit
-- go.mod --
module knope
-- knope.toml --
[packages.v1]
versioned_files = ["go.mod", "sub_dir/go.mod"]
scopes = ["v1"]
changelog = "CHANGELOG.md"

[packages.v2]
versioned_files = ["v2/go.mod", "sub_dir/v2/go.mod"]
scopes = ["v2"]
changelog = "v2/CHANGELOG.md"

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"

[[workflows.steps]]
type = "Release"
-- sub_dir/EXPECTED_go.mod --
-- sub_dir/go.mod --
module sub_dir/knope
-- sub_dir/v2/go.mod --
module sub_dir/knope/v2
-- v2/CHANGELOG.md --
# CHANGELOG

## 2.0.0

- Initial commit
