# Ported from knope-dev/knope, crates/knope/tests/prepare_release/release_after_prerelease (MIT, see testdata/README.md).

env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'feat: Existing feature' --author 'Knope <knope@example.com>'
exec git tag v1.0.0
exec git commit --allow-empty -m 'feat!: Breaking change' --author 'Knope <knope@example.com>'
exec git commit --allow-empty -m 'feat: New feature' --author 'Knope <knope@example.com>'
exec git tag v1.1.0-rc.1

exec remeris --dry-run release
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris release
! stdout .
! stderr .
cmp CHANGELOG.md out/CHANGELOG.md
cmp Cargo.toml out/Cargo.toml

-- CHANGELOG.md --
## 1.1.0-rc.1

### Features

- New feature

## 1.0.0

### Features

- Existing Feature
-- Cargo.toml --
[package]
name = "default"
version = "1.1.0-rc.1"
-- knope.toml --
[package]
versioned_files = ["Cargo.toml"]
changelog = "CHANGELOG.md"

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 2.0.0
Would add the following to CHANGELOG.md:
## 2.0.0 (2026-01-01)

### Breaking Changes

- Breaking change

### Features

- New feature

Would add files to git:
  Cargo.toml
  CHANGELOG.md
-- out/CHANGELOG.md --
## 2.0.0 (2026-01-01)

### Breaking Changes

- Breaking change

### Features

- New feature

## 1.1.0-rc.1

### Features

- New feature

## 1.0.0

### Features

- Existing Feature
-- out/Cargo.toml --
[package]
name = "default"
version = "2.0.0"
