# Ported from knope-dev/knope, crates/knope/tests/prepare_release/ignore_conventional_commits_toplevel (MIT, see testdata/README.md).

env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'feat: Existing' --author 'Knope <knope@example.com>'
exec git tag v1.0.0
exec git commit --allow-empty -m 'feat!: Breaking change that should be ignored' --author 'Knope <knope@example.com>'

exec remeris --dry-run prepare-release
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris prepare-release
! stdout .
! stderr .
! exists .changeset/a_new_feature.md
cmp Cargo.toml out/Cargo.toml
cmp CHANGELOG.md out/CHANGELOG.md

-- .changeset/a_new_feature.md --
---
default: minor
---

# A new feature
-- CHANGELOG.md --
# Changelog
-- Cargo.toml --
[package]
version = "1.0.0"
name = "test-ignore-conventional-commits-toplevel"
-- knope.toml --
[changes]
ignore_conventional_commits = true

[package]
versioned_files = ["Cargo.toml"]
changelog = "CHANGELOG.md"

[[workflows]]
name = "prepare-release"

[[workflows.steps]]
type = "PrepareRelease"
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 1.1.0
Would delete .changeset/a_new_feature.md
Would add the following to CHANGELOG.md:
## 1.1.0 (2026-01-01)

### Features

- A new feature

Would add files to git:
  Cargo.toml
  .changeset/a_new_feature.md
  CHANGELOG.md
-- out/CHANGELOG.md --
# Changelog
## 1.1.0 (2026-01-01)

### Features

- A new feature
-- out/Cargo.toml --
[package]
version = "1.1.0"
name = "test-ignore-conventional-commits-toplevel"
