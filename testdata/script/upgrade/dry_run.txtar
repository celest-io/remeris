# Knope ignores --dry-run here and writes. Remeris prints what would be written and changes nothing.

cp knope.toml before.toml
exec remeris --dry-run --upgrade
cmp stdout stdout.log
! stderr .
cmp knope.toml before.toml

# Nothing to upgrade is reported the same way.
cp nothing.toml knope.toml
exec remeris --dry-run --upgrade
cmp stdout nothing.log
cmp knope.toml nothing.toml

-- knope.toml --
[package]
changelog = "CHANGELOG.md"

[[workflows]]
name = "prepare-release"

[[workflows.steps]]
type = "PrepareRelease"
ignore_conventional_commits = true
-- stdout.log --
Would upgrade knope.toml:
[changes]
ignore_conventional_commits = true

[package]
changelog = "CHANGELOG.md"

[[workflows]]
name = "prepare-release"

[[workflows.steps]]
type = "PrepareRelease"
-- nothing.toml --
[[workflows]]
name = "No-op"
steps = []
-- nothing.log --
Nothing to upgrade
