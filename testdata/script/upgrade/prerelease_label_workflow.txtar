# The same with a workflow name and the flag: still no label in the file.

env REMERIS_PRERELEASE_LABEL=rc
exec remeris --upgrade prepare-release --prerelease-label beta
! grep prerelease_label knope.toml
cmp knope.toml out.toml

-- knope.toml --
[package]
changelog = "CHANGELOG.md"

[[workflows]]
name = "prepare-release"

[[workflows.steps]]
type = "PrepareRelease"
ignore_conventional_commits = true
-- out.toml --
[changes]
ignore_conventional_commits = true

[package]
changelog = "CHANGELOG.md"

[[workflows]]
name = "prepare-release"

[[workflows.steps]]
type = "PrepareRelease"
