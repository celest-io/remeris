# Ported from knope-dev/knope, crates/knope/tests/multi_forge_release/version_go_mod (MIT, see testdata/README.md).
# A go.mod in a subdirectory gets its module tag locally, next to the GitHub and Gitea releases.
# Knope only runs this as a dry run (a real release needs the GitHub and Gitea API); so does this script. A dry run reads no
# credentials and makes no request. [COMMIT] is the HEAD commit, matched as 40 hex digits.
env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'feat: Existing feature' --author 'Knope <knope@example.com>'
exec git tag v1.0.0
exec git tag go/v1.0.0
exec git commit --allow-empty -m 'feat: New feature' --author 'Knope <knope@example.com>'

exec remeris release --dry-run
rstrip stdout stdout_actual.log
grep '(?s)\AWould add the following to Cargo\.toml: version = 1\.1\.0\nWould add the following to go/go\.mod: 1\.1\.0\nWould add the following to CHANGELOG\.md:\n## 1\.1\.0 \(2026-01-01\)\n\n### Features\n\n- New feature\n\nWould add files to git:\n  Cargo\.toml\n  go/go\.mod\n  CHANGELOG\.md\nWould create Git tag go/v1\.1\.0\nWould create a release on GitHub with name 1\.1\.0 \(2026-01-01\) and tag v1\.1\.0 at commit [0-9a-f]{40} and body:\n## Features\n\n- New feature\nWould create a release on Gitea \[https://codeberg\.org\] with name 1\.1\.0 \(2026-01-01\) and tag v1\.1\.0 at commit [0-9a-f]{40} and body:\n## Features\n\n- New feature\n\z' stdout_actual.log
! stderr .

exec git tag --list
! stdout 'v1\.1\.0|2\.0\.0|0\.5\.0|go/v1\.1\.0'
-- CHANGELOG.md --
## 1.0.0

### Features

- New feature in existing release
-- Cargo.toml --
[package]
name = "default"
version = "1.0.0"
-- go/go.mod --
module codeberg.org/owner/repo
-- knope.toml --
[package]
versioned_files = ["Cargo.toml", "go/go.mod"]
changelog = "CHANGELOG.md"

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"

[[workflows.steps]]
type = "Release"

[gitea]
owner = "knope-dev"
repo = "knope"
host = "https://codeberg.org"

[github]
owner = "knope-dev"
repo = "knope"
