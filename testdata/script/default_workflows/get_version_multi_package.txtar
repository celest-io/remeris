# Ported from knope-dev/knope, crates/knope/tests/default_workflows/get_version/multi_package (MIT, see testdata/README.md).
# With several packages there is no get-version workflow, so the command is not recognised. remeris reports an
# unknown workflow in its own words (cli/no_workflow); Knope prints clap's message (see testdata/deviations.md).

! exec remeris get-version
! stdout .
cmp stderr stderr.log

-- Cargo.toml --
[package]
name = "single-package-get-version"
version = "1.23.45"
-- knope.toml --
[packages.rust]
versioned_files = ["Cargo.toml"]

[packages.js]
versioned_files = ["package.json"]
-- package.json --
{
  "version": "13.24.54"
}
-- stderr.log --
Error: No workflow named get-version
