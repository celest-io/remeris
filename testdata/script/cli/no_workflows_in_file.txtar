# A knope.toml without workflows gets the default ones (a hybrid config), and still has --validate.
exec remeris --help
stdout 'release'
stdout 'document-change'
stdout '--validate'
! stdout '--generate'

# The release workflow fails validation until PrepareRelease exists; document-change is valid.
! exec remeris --validate
stderr 'Problem with workflow release'

-- knope.toml --
[github]
owner = "celest-io"
repo = "remeris"
