# Steps that are decoded but not built yet fail with the milestone that brings them, in a real run
# and in a dry run alike.
! exec remeris release
! stdout .
cmp stderr release.log

! exec remeris --dry-run release
cmp stderr release.log

# Steps before it still run, and --generate says when it will exist.
exec remeris --dry-run before
cmp stdout before.log

! exec remeris --generate
stderr 'unexpected argument ''--generate'' found'

-- knope.toml --
[[workflows]]
name = "release"
steps = [{ type = "RebaseBranch", to = "main" }]

[[workflows]]
name = "before"
steps = [{ type = "Command", command = "echo first" }]
-- release.log --
Error: Problem with workflow release
  ╰─▶ Step RebaseBranch is not implemented yet (milestone M11)
-- before.log --
Would run echo first
