# --help lists the workflows from knope.toml, with their help text, and the flags. The exact layout
# is urfave/cli's, so only the content is checked.
exec remeris --help
stdout 'remeris'
stdout 'shell-command +Say hello'
stdout 'other'
stdout '--dry-run'
stdout '--verbose, -v'
stdout '--validate'
stdout '--upgrade'
stdout '--github-app-id'
stdout '--github-installation-id'
stdout '--github-app-private-key-path'
stdout 'REMERIS_GITHUB_APP_PRIVATE_KEY'
stdout '--github-api-url'
stdout 'REMERIS_GITHUB_API_URL'
stdout '--github-upload-url'
stdout 'REMERIS_GITHUB_UPLOAD_URL'
! stdout '--generate'
! stderr .

# A workflow's own help shows its flags, and the root flags that apply to it.
exec remeris other --help
stdout '--prerelease-label'
stdout 'REMERIS_PRERELEASE_LABEL'
stdout 'KNOPE_PRERELEASE_LABEL'
! stdout '--override-version'
stdout '--dry-run'
stdout '--github-app-id'

-- knope.toml --
[[workflows]]
name = "shell-command"
help_text = "Say hello"
steps = [{ type = "Command", command = "echo hello" }]

[[workflows]]
name = "other"
steps = [{ type = "PrepareRelease" }]
