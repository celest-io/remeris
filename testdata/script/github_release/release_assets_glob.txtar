# Ported from knope-dev/knope, crates/knope/tests/github_release/release_assets/glob (MIT, see testdata/README.md).
# `assets` as a glob pattern: every match is listed (and would be uploaded).
# Knope only runs this as a dry run (a real release needs the GitHub API); so does this script. A dry run reads no
# credentials and makes no request. [COMMIT] is the HEAD commit, matched as 40 hex digits.
env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'feat: Existing feature' --author 'Knope <knope@example.com>'
exec git tag v1.0.0
exec git commit --allow-empty -m 'feat: New feature' --author 'Knope <knope@example.com>'

exec remeris release --dry-run
rstrip stdout stdout_actual.log
grep '(?s)\AWould create a release on GitHub with name 1\.1\.0 \(2026-01-01\) and tag v1\.1\.0 at commit [0-9a-f]{40} and body:\n## Features\n\n- New feature\nWould upload assets to GitHub:\n- first from assets/first\n- second from assets/second\n\z' stdout_actual.log
! stderr .

exec git tag --list
! stdout 'v1\.1\.0|2\.0\.0|0\.5\.0|go/v1\.1\.0'
-- CHANGELOG.md --
## 1.1.0 (2026-01-01)

### Features

- New feature

## 1.0.0

### Features

- New feature in existing release
-- Cargo.toml --
[package]
name = "default"
version = "1.1.0"
-- assets/first --
first
-- assets/second --
second
-- knope.toml --
[package]
versioned_files = ["Cargo.toml"]
changelog = "CHANGELOG.md"
assets = "assets/*"

[[workflows]]
name = "release"

[[workflows.steps]]
type = "Release"

[github]
owner = "knope-dev"
repo = "knope"
