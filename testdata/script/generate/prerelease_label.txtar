# Not in Knope's fixtures, but Knope handles --generate before it applies --prerelease-label: the label never
# reaches the generated file, whether it comes from the flag or from either environment variable.
exec git init --initial-branch=main
exec remeris --generate release --prerelease-label rc
! stderr .
! grep prerelease_label knope.toml
cmp knope.toml plain.toml

rm knope.toml
env REMERIS_PRERELEASE_LABEL=rc
exec remeris --generate release
! grep prerelease_label knope.toml
cmp knope.toml plain.toml

rm knope.toml
env REMERIS_PRERELEASE_LABEL=
env KNOPE_PRERELEASE_LABEL=rc
exec remeris --generate release
! grep prerelease_label knope.toml
cmp knope.toml plain.toml
-- plain.toml --
[[workflows]]
name = "release"
help_text = "Prepare and create a new release (update changelog, bump version, create release)"

[[workflows.steps]]
type = "PrepareRelease"

[[workflows.steps]]
type = "Command"
command = 'git commit -m "chore: prepare release $version"'

[[workflows.steps]]
type = "Release"

[[workflows.steps]]
type = "Command"
command = "git push"

[[workflows.steps]]
type = "Command"
command = "git push --tags"

[[workflows]]
name = "document-change"
help_text = "Create a new change file to be included in the next release"

[[workflows.steps]]
type = "CreateChangeFile"
