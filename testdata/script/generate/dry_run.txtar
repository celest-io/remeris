# Not in Knope, which ignores --dry-run here and writes the file. A dry run writes nothing and prints the file.
exec git init --initial-branch=main
exec git remote add origin https://github.com/knope-dev/knope.git
exec remeris --dry-run --generate
cmp stdout dry-run.log
! stderr .
! exists knope.toml

# The flag may come after the mode as well, and the output is the file a real run writes.
exec remeris --generate --dry-run
cmp stdout dry-run.log
! exists knope.toml

exec remeris --generate
cmp knope.toml want.toml
-- dry-run.log --
Would generate a knope.toml file:
[[workflows]]
name = "release"
help_text = "Prepare and create a new release (update changelog, bump version, create release)"

[[workflows.steps]]
type = "PrepareRelease"

[[workflows.steps]]
type = "Command"
command = 'git commit -m "chore: prepare release $version"'

[[workflows.steps]]
type = "Command"
command = "git push"

[[workflows.steps]]
type = "Release"

[[workflows]]
name = "document-change"
help_text = "Create a new change file to be included in the next release"

[[workflows.steps]]
type = "CreateChangeFile"

[github]
owner = "knope-dev"
repo = "knope"
-- want.toml --
[[workflows]]
name = "release"
help_text = "Prepare and create a new release (update changelog, bump version, create release)"

[[workflows.steps]]
type = "PrepareRelease"

[[workflows.steps]]
type = "Command"
command = 'git commit -m "chore: prepare release $version"'

[[workflows.steps]]
type = "Command"
command = "git push"

[[workflows.steps]]
type = "Release"

[[workflows]]
name = "document-change"
help_text = "Create a new change file to be included in the next release"

[[workflows.steps]]
type = "CreateChangeFile"

[github]
owner = "knope-dev"
repo = "knope"
