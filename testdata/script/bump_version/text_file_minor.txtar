# Ported from knope-dev/knope, crates/knope/tests/bump_version/text_file/minor (MIT, see testdata/README.md).

exec git init
exec git config user.email fake@remeris.dev
exec git config user.name 'Fake remeris'
exec git add README.md knope.toml
exec git commit -m 'initial commit'
exec git tag 1.0.0
exec git commit --allow-empty -m 'feat: add feature'

exec remeris --dry-run bump
cmp stdout dryrun_stdout.log

exec remeris bump
! stdout .
cmp README.md out/README.md

-- README.md --
steps:
  - uses: knope-dev/action@v1
    with:
      version: 1.0.0
-- knope.toml --
[package]
versioned_files = [
  { path = "README.md", regex = "version:\\s+(?<version>\\d+\\.\\d+\\.\\d+)" },
]

[[workflows]]
name = "bump"

[[workflows.steps]]
type = "BumpVersion"
rule = "Minor"
-- dryrun_stdout.log --
Would add the following to README.md: version: 1.1.0
-- out/README.md --
steps:
  - uses: knope-dev/action@v1
    with:
      version: 1.1.0
