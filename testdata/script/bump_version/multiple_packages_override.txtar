# Ported from knope-dev/knope, crates/knope/tests/bump_version/multiple_packages/override (MIT, see testdata/README.md).

exec git init
exec git config user.email fake@remeris.dev
exec git config user.name 'Fake remeris'
exec git add Cargo.toml knope.toml package.json pyproject.toml
exec git commit -m 'Initial commit'
exec git tag v1.2.3

exec remeris --dry-run bump --override-version=rust=1.0.0 --override-version=python=4.3.2
cmp stdout dryrun_stdout.log

exec remeris bump --override-version=rust=1.0.0 --override-version=python=4.3.2
! stdout .
cmp Cargo.toml out/Cargo.toml
# The output has no final newline (Q10) and txtar cannot say so, so check the diff.
exec git diff --unified=0 package.json
stdout '(?m)^\+  "version": "7\.0\.0"$'
stdout '(?m)^\+\}\n\\ No newline at end of file'
cmp pyproject.toml out/pyproject.toml

-- Cargo.toml --
[package]
name = "multiple-packages"
version = "0.1.2"
-- knope.toml --
[packages.rust]
versioned_files = ["Cargo.toml"]

[packages.javascript]
versioned_files = ["package.json"]

[packages.python]
versioned_files = ["pyproject.toml"]

[[workflows]]
name = "bump"

[[workflows.steps]]
type = "BumpVersion"
rule = "Major"
-- package.json --
{
  "version": "6.7.8"
}
-- pyproject.toml --
[tool.poetry]
version = "3.4.5"
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 1.0.0
Would add the following to package.json: version = 7.0.0
Would add the following to pyproject.toml: 4.3.2
-- out/Cargo.toml --
[package]
name = "multiple-packages"
version = "1.0.0"
-- out/pyproject.toml --
[tool.poetry]
version = "4.3.2"
