# SwitchBranches switches to an existing branch named after the issue, without asking anything.
exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git add .
exec git commit -m 'Initial commit'
exec git branch 12-fix-thing
exec git switch -c 12-Fix-Thing

exec remeris switch
cmp stdout switched.log
! stderr .
exec git branch --show-current
stdout '^12-fix-thing$'

-- knope.toml --
[[workflows]]
name = "switch"
[[workflows.steps]]
type = "SelectIssueFromBranch"
[[workflows.steps]]
type = "SwitchBranches"
-- switched.log --
Auto-selecting issue 12 from ref 12-Fix-Thing
Found existing branch named 12-fix-thing, switching to it.
