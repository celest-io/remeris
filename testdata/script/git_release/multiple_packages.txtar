# Ported from knope-dev/knope, crates/knope/tests/git_release/multiple_packages (MIT, see testdata/README.md).
# Each package in knope.toml is released on its own, with its own tag, from the commits that touch it.
env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git commit --allow-empty -m 'feat: Existing feature' --author 'Knope <knope@example.com>'
exec git tag first/v1.2.3
exec git tag second/v0.4.6
exec git commit --allow-empty -m 'feat!: New breaking feature' --author 'Knope <knope@example.com>'

exec remeris release --dry-run
rstrip stdout dryrun_actual.log
cmp dryrun_actual.log dryrun_stdout.log
! stderr .

exec remeris release
stdout '(?m)\A\[main [0-9a-f]+\] chore: Prepare release\n 5 files changed, 26 insertions\(\+\)\n create mode 100644 Cargo\.toml\n create mode 100644 FIRST_CHANGELOG\.md\n create mode 100644 SECOND_CHANGELOG\.md\n create mode 100644 package\.json\n create mode 100644 pyproject\.toml\n\z'
! stderr .
cmp Cargo.toml out/Cargo.toml
cmp pyproject.toml out/pyproject.toml
cmp FIRST_CHANGELOG.md out/FIRST_CHANGELOG.md
cmp SECOND_CHANGELOG.md out/SECOND_CHANGELOG.md
grep '"version": "0\.5\.0"' package.json

exec git tag --contains HEAD
stdout '(?m)\Afirst/v2\.0\.0\nsecond/v0\.5\.0\n\z'

-- Cargo.toml --
[package]
name = "default"
version = "1.2.3"
-- FIRST_CHANGELOG.md --
## 1.2.3

Some existing content
-- SECOND_CHANGELOG.md --
## 0.4.6

Some existing content
-- knope.toml --
[packages.first]
versioned_files = ["Cargo.toml", "pyproject.toml"]
changelog = "FIRST_CHANGELOG.md"

[packages.second]
versioned_files = ["package.json"]
changelog = "SECOND_CHANGELOG.md"

[[workflows]]
name = "release"

[[workflows.steps]]
type = "PrepareRelease"

[[workflows.steps]]
type = "Command"
command = "git commit -m \"chore: Prepare release\""

[[workflows.steps]]
type = "Release"
-- package.json --
{
  "version": "0.4.6"
}
-- pyproject.toml --
[tool.poetry]
version = "1.2.3"
-- dryrun_stdout.log --
Would add the following to Cargo.toml: version = 2.0.0
Would add the following to pyproject.toml: 2.0.0
Would add the following to package.json: version = 0.5.0
Would add the following to FIRST_CHANGELOG.md:
## 2.0.0 (2026-01-01)

### Breaking Changes

- New breaking feature

Would add the following to SECOND_CHANGELOG.md:
## 0.5.0 (2026-01-01)

### Breaking Changes

- New breaking feature

Would add files to git:
  Cargo.toml
  pyproject.toml
  package.json
  FIRST_CHANGELOG.md
  SECOND_CHANGELOG.md
Would run git commit -m "chore: Prepare release"
Would create Git tag first/v2.0.0
Would create Git tag second/v0.5.0
-- out/Cargo.toml --
[package]
name = "default"
version = "2.0.0"
-- out/FIRST_CHANGELOG.md --
## 2.0.0 (2026-01-01)

### Breaking Changes

- New breaking feature

## 1.2.3

Some existing content
-- out/SECOND_CHANGELOG.md --
## 0.5.0 (2026-01-01)

### Breaking Changes

- New breaking feature

## 0.4.6

Some existing content
-- out/pyproject.toml --
[tool.poetry]
version = "2.0.0"
