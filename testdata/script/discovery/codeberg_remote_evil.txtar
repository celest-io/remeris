# A remote that only mentions codeberg.org in its path is not Gitea: the parsed host must equal a known public host (spec F20.6).
# Ours; Knope matches remote.contains("codeberg.org") and would detect Gitea here (see testdata/deviations.md).
env REMERIS_FAKE_DATE=2026-01-01

exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git remote add origin https://evil.example/codeberg.org/r
exec git add .
exec git commit -m 'feat: Existing' --author 'Knope <knope@example.com>'
exec git tag v1.0.0
exec git commit --allow-empty -m 'feat: New Feature' --author 'Knope <knope@example.com>'

exec remeris release --dry-run
rstrip stdout stdout_actual.log
cmp stdout_actual.log stdout.log
! stderr .

-- Cargo.toml --
[package]
name = "my-package"
version = "1.0.0"
-- CHANGELOG.md --
## 1.0.0

### Features

- Existing
-- stdout.log --
Would add the following to Cargo.toml: version = 1.1.0
Would add the following to CHANGELOG.md:
## 1.1.0 (2026-01-01)

### Features

- New Feature

Would add files to git:
  Cargo.toml
  CHANGELOG.md
Would run git commit -m "chore: prepare release 1.1.0"
Would create Git tag v1.1.0
Would run git push
Would run git push --tags
