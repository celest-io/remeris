# pom.xml is found by default detection, but its format is milestone M9. The error is the one an explicit
# versioned_files entry gives; the file is not dropped silently.
! exec remeris release --dry-run
stderr 'Versioned file format MavenPom is not implemented yet \(milestone M9\)'

-- Cargo.toml --
[package]
name = "my-package"
version = "1.0.0"
-- pom.xml --
<project>
  <version>1.0.0</version>
</project>
