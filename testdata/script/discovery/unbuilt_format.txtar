# Cargo.lock is found by default detection, but its format is milestone M9. The error is the one an explicit
# versioned_files entry gives; the file is not dropped silently.
! exec remeris release --dry-run
stderr 'Versioned file format CargoLock is not implemented yet \(milestone M9\)'

-- Cargo.toml --
[package]
name = "my-package"
version = "1.0.0"
-- Cargo.lock --
version = 3
