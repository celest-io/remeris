# A broken Cargo workspace only fails the workflows that read the packages. A Command step that does not use $version
# or $changelog runs as it did before package discovery existed, and the error is the one of the member.
exec remeris show
stdout '^shown$'
! stderr .

# $version needs the packages, so it reports the discovery error.
! exec remeris version
stderr 'Error reading from missing/Cargo.toml: '

# So does any of the steps that work on packages.
! exec remeris prepare
stderr 'Error reading from missing/Cargo.toml: '

# Without variables, $version is plain text.
exec remeris plain
stdout '^\$version$'

-- Cargo.toml --
[workspace]
members = ["first", "missing"]
-- first/Cargo.toml --
[package]
name = "first-package"
version = "1.0.0"
-- knope.toml --
[[workflows]]
name = "show"

[[workflows.steps]]
type = "Command"
command = "echo shown"

[[workflows]]
name = "version"

[[workflows.steps]]
type = "Command"
command = "echo $version"

[[workflows]]
name = "prepare"

[[workflows.steps]]
type = "PrepareRelease"

[[workflows]]
name = "plain"

[[workflows.steps]]
type = "Command"
command = "echo $version"

[workflows.steps.variables]
