# A Cargo workspace root is discovered as one package per member (spec F20.2). The packages are found when the
# project is loaded, so --help and --validate see them: two packages means no get-version workflow.
exec remeris --help
stdout 'release +Prepare and create a new release'
stdout 'document-change'
! stdout 'get-version'
! stderr .

# The release dry run shows the discovered files: first depends on second, so it is versioned in first/Cargo.toml.
exec git init --initial-branch=main
exec git config user.email fake@remeris.dev
exec git config user.name "Fake remeris"
exec git add .
exec git commit -m 'Initial commit'
exec git tag first-package/v1.0.0
exec git tag second-package/v1.0.0
exec git commit --allow-empty -m 'feat(second-package): A feature'
exec remeris release --dry-run
stdout 'Would add the following to first/Cargo.toml: second-package.version = 1.1.0'
stdout 'Would add the following to second/Cargo.toml: version = 1.1.0'
stdout 'Would add files to git:\n  first/Cargo.toml\n  second/Cargo.toml'
! stderr .

# A knope.toml without packages is discovered the same way.
cp knope.toml.empty knope.toml
exec remeris --validate
! stdout .
! stderr .

# A knope.toml that declares the packages needs no discovery: a broken member is not read.
cp knope.toml.declared knope.toml
cp Cargo.toml.broken Cargo.toml
exec remeris --dry-run show
stdout shown
! stderr .

-- Cargo.toml --
[workspace]
members = ["first", "second"]
-- first/Cargo.toml --
[package]
name = "first-package"
version = "1.0.0"

[dependencies]
second-package = "1.0.0"
-- second/Cargo.toml --
[package]
name = "second-package"
version = "1.0.0"
-- knope.toml.empty --
[changes]
-- knope.toml.declared --
[package]
versioned_files = ["first/Cargo.toml"]

[[workflows]]
name = "show"

[[workflows.steps]]
type = "Command"
command = "echo shown"
-- Cargo.toml.broken --
[workspace]
members = ["missing"]
