# The npm half of this script moved to npm_workspaces.txtar and npm_workspaces_errors.txtar (milestone M10 PR 64).
# Deno workspace roots are errors until their detector is built (PR 65a, which owns the rest of this file).
cd deno
! exec remeris release --dry-run
stderr 'Package discovery for Deno workspaces is not implemented yet \(milestone M10\)'

-- deno/deno.jsonc --
{
  // members
  "workspace": ["./a"],
}
-- deno/a/deno.json --
{ "name": "a", "version": "1.0.0" }
