#!/usr/bin/env bash
#MISE description="Build the release archives and SHA256SUMS into dist/ (usage: mise run dist -- v0.0.1)"
# Cross-builds remeris for linux, darwin and windows on amd64 and arm64 with plain `go build` (CGO off, -trimpath, -buildvcs=false),
# injecting the version information like mise-tasks/build. Output, for a version v0.0.1:
#   dist/remeris_v0.0.1_<os>_<arch>.tar.gz (zip for windows), each holding remeris (remeris.exe), LICENSE and README.md
#   dist/SHA256SUMS
# The output is reproducible: the same commit, Go toolchain and GNU tools give identical archives. For that, the build date is the commit
# time (SOURCE_DATE_EPOCH, default `git log -1 --format=%ct`), the build user, branch and number are fixed (release, release, unknown), and
# the archives have sorted entries, fixed owners, modes and times, and no gzip name or time.
# Needs GNU tar, gzip, zip, date and sha256sum (Linux). Environment: DIST_DIR (default dist), DIST_TARGETS (space-separated os/arch pairs,
# default all six), SOURCE_DATE_EPOCH.
set -euo pipefail

pkg=github.com/celest-io/remeris/internal/version
default_targets="linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 windows/amd64 windows/arm64"

# normalize_version prints the tag form (v0.0.1) of a version given with or without the leading v.
normalize_version() {
  local v="${1:?version required}"
  v="${v#v}"
  if [[ ! "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$ ]]; then
    echo "dist: '$1' is not a SemVer version" >&2
    return 1
  fi
  printf 'v%s\n' "$v"
}

# ldflags_for prints the -ldflags value for a tag and a build date epoch.
ldflags_for() {
  local tag="$1" epoch="$2" revision build_date go_version flags
  revision="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
  build_date="$(date -u -d "@${epoch}" '+%Y-%m-%d_%H:%M:%S')"
  go_version="$(go version | awk '{print $3}')"
  flags=(
    "-X '${pkg}.Version=${tag}'"
    "-X '${pkg}.Revision=${revision}'"
    "-X '${pkg}.Branch=release'"
    "-X '${pkg}.BuildUser=release'"
    "-X '${pkg}.BuildDate=${build_date}'"
    "-X '${pkg}.GoVersion=${go_version}'"
  )
  echo "${flags[*]}"
}

# build_target builds and archives one os/arch pair into $out.
build_target() {
  local tag="$1" target="$2" out="$3" ldflags="$4" epoch="$5"
  local goos="${target%/*}" goarch="${target#*/}"
  local name="remeris_${tag}_${goos}_${goarch}" exe=remeris stage
  [ "$goos" = windows ] && exe=remeris.exe

  stage="$(mktemp -d)"
  mkdir "${stage}/${name}"
  CGO_ENABLED=0 GOOS="$goos" GOARCH="$goarch" go build -trimpath -buildvcs=false -ldflags "$ldflags" \
    -o "${stage}/${name}/${exe}" ./cmd/remeris
  cp LICENSE README.md "${stage}/${name}/"
  chmod 0755 "${stage}/${name}" "${stage}/${name}/${exe}"
  chmod 0644 "${stage}/${name}/LICENSE" "${stage}/${name}/README.md"

  if [ "$goos" = windows ]; then
    touch -d "@${epoch}" "${stage}/${name}" "${stage}/${name}"/*
    (cd "$stage" && find "$name" | LC_ALL=C sort | TZ=UTC zip --quiet -X -@ "${out}/${name}.zip")
  else
    tar --create --file - --directory "$stage" --sort=name --mtime="@${epoch}" --owner=0 --group=0 --numeric-owner "$name" |
      gzip -n -9 >"${out}/${name}.tar.gz"
  fi
  rm -rf "$stage"
  echo "built ${name}"
}

main() {
  local tag out ldflags epoch target
  tag="$(normalize_version "${1:-}")"
  out="$(realpath -m "${DIST_DIR:-dist}")"
  epoch="${SOURCE_DATE_EPOCH:-$(git log -1 --format=%ct)}"
  ldflags="$(ldflags_for "$tag" "$epoch")"

  rm -rf "$out"
  mkdir -p "$out"
  for target in ${DIST_TARGETS:-$default_targets}; do
    build_target "$tag" "$target" "$out" "$ldflags" "$epoch"
  done
  (
    cd "$out"
    shopt -s nullglob
    archives=(*.tar.gz *.zip)
    sha256sum -- "${archives[@]}" >SHA256SUMS
    sha256sum --check SHA256SUMS
  )
}

# Run main only when executed, so the functions can be sourced by a test.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
