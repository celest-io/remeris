#!/usr/bin/env bash
#MISE description="Check the configuration, the SEO audit, and the internal links, anchors and assets of the documentation website (no network)"
#MISE dir="{{config_root}}/website"
set -euo pipefail

if [ ! -d node_modules ]; then
  npm ci
fi
npm run doctor
npm run validate
# SEO and site health of the built site (titles, descriptions, canonicals, structured data, sitemap); offline. Warnings fail, so a page
# without its own description is caught.
npx blume audit --strict
